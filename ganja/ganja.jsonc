{
  "$schema": "file:///Users/zchee/rust/src/github.com/zchee/ganja-code/schema/ganja-config.schema.json",
  "model": "openai/gpt-5.6-sol",
  "small_model": "cursor/gpt-5.6-luna-medium-fast",
  "effort": "max",
  "default_provider": "openai",
  "default_agent": "build",
  "openrouter": {
    "server_tools": [
      "advisor",
      "apply_patch",
      "datetime",
      "experimental__search_models",
      "fusion",
      "image_generation",
      "shell",
      "subagent",
      "web_fetch",
      "web_search"
    ]
  },
  "memory": true,
  "agent": {},
  "agents": {
    "concurrency": 10
  },
  "permission": {},
  "instructions": [],
  "theme": "claude",
  "theme_mode": "dark",
  "keybinds": {},
  "shell": "/opt/homebrew/bin/zsh",
  "tool_defer_threshold": 32,
  "command": {},
  "mcp": {
    "context7": {
      "oauth": {},
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }
  },
  "lsp": true,
  "provider": {
    "ollama": {
      "dialect": "openai-chat-completions",
      "base_url": "http://127.0.0.1:11434/v1",
      "key_env": "LOCAL_OLLAMA_KEY"
    }
  },
  "webfetch": {
    "allow_private": true
  },
  "skills": {
    "paths": [],
    "urls": []
  },
  "snapshot": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "imectl set -q com.apple.keylayout.ABC"
          }
        ]
      }
    ]
  },
  "tui": {
    "notifications": true,
    "notification_method": "osc9",
    "statusline": {
      "elements": [
        "activity",
        "git",
        "model",
        "cwd",
        "context",
        "rate",
        "tokens",
        "session",
        "agent",
        "effort",
        "todos",
        "queued",
        "jobs",
        "tasks",
        "dialogs",
        "notice",
        "hints"
      ],
      "detail": true
    }
  }
}
